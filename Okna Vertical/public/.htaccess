Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
RewriteRule ^osteklenie-kottedzhey(?:/index\.html|/)?$ https://okna-vertical.ru/okna-v-chastnyj-dom/ [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.okna-vertical\.ru$ [NC]
RewriteRule ^ https://okna-vertical.ru%{REQUEST_URI} [R=301,L]
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L]
