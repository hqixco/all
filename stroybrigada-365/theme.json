{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "defaultPalette": false
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    }
  }
}

